#!/usr/bin/env php
<?php
/**
 * Runs everything: the static checks, the PHP unit tests in tests/unit/ and
 * the browser tests in tests/browser/ (Playwright).
 *
 *   bin/test                     everything
 *   bin/test --php               only checks and unit tests
 *   bin/test -- <playwright args> pass arguments on, for example
 *                                 bin/test -- --update-snapshots   to approve new screenshots
 *                                 bin/test -- -g "404"             to run matching tests only
 *
 * The browser tests use a frozen database, data/test/site.sqlite (bin/test-db).
 *
 * A test file returns an array of 'description' => function () { ... }.
 * Inside, use same($expected, $actual) and ok($condition, $message).
 */

declare(strict_types=1);

require dirname(__DIR__) . '/src/autoload.php';

final class TestFailure extends Exception
{
}

function same(mixed $expected, mixed $actual, string $message = ''): void
{
    if ($expected !== $actual) {
        throw new TestFailure(($message ? "$message: " : '') . 'expected ' . var_export($expected, true) . ', got ' . var_export($actual, true));
    }
}

function ok(bool $condition, string $message = 'condition is false'): void
{
    if (!$condition) {
        throw new TestFailure($message);
    }
}

passthru(PHP_BINARY . ' ' . escapeshellarg(__DIR__ . '/check'), $checkCode);

$passed = 0;
$failed = 0;
foreach (glob(dirname(__DIR__) . '/tests/unit/*.php') as $file) {
    foreach (require $file as $name => $test) {
        try {
            $test();
            $passed++;
        } catch (Throwable $e) {
            $failed++;
            printf("FAIL %s: %s\n     %s\n", basename($file, '.php'), $name, $e->getMessage());
        }
    }
}
printf("Unit tests: %d passed, %d failed.\n", $passed, $failed);

$args = array_slice($argv, 1);
$browserCode = 0;
if (!in_array('--php', $args, true)) {
    $root = dirname(__DIR__);
    if (!is_file("$root/data/test/site.sqlite")) {
        passthru(PHP_BINARY . ' ' . escapeshellarg(__DIR__ . '/test-db'));
    }
    if (!is_dir("$root/tests/browser/node_modules")) {
        echo "Installing the browser test tools (once)...\n";
        passthru('cd ' . escapeshellarg("$root/tests/browser") . ' && npm ci --no-audit --no-fund && npx playwright install chromium');
    }
    $pass = ($i = array_search('--', $args, true)) === false ? [] : array_slice($args, $i + 1);
    passthru('cd ' . escapeshellarg("$root/tests/browser") . ' && npx playwright test ' . implode(' ', array_map('escapeshellarg', $pass)), $browserCode);
    $report = "$root/tests/browser/reports/contrast.txt";
    if (is_file($report)) {
        $n = count(file($report, FILE_SKIP_EMPTY_LINES));
        echo "Colour contrast: $n element(s) below WCAG AA, listed in tests/browser/reports/contrast.txt (not a failure; colours are reviewed after the site is built).\n";
    }
}
exit($failed || $checkCode || $browserCode ? 1 : 0);
